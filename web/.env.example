# GitHub OAuth App Client ID (required for Login with GitHub)
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to your GitHub Pages URL (e.g. https://YOUR-ORG.github.io/CrestronAISkills)
VITE_GITHUB_CLIENT_ID=

# Registry URL (auto-set by GitHub Actions, override for local dev)
# VITE_REGISTRY_URL=https://raw.githubusercontent.com/YOUR-ORG/CrestronAISkills/main/registry.json

# Repository URL for links
# VITE_REPO_URL=https://github.com/YOUR-ORG/CrestronAISkills

# Base path for GitHub Pages (e.g. /CrestronAISkills/)
# VITE_BASE_PATH=/CrestronAISkills/
