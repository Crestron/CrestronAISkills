{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Copilot Skill Frontmatter",
  "description": "YAML frontmatter required in every skill.md file",
  "type": "object",
  "required": ["name", "version", "description", "tags", "author"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$", "description": "Unique kebab-case skill identifier" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semantic version" },
    "description": { "type": "string", "minLength": 10, "maxLength": 200 },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "author": { "type": "string", "description": "GitHub username" },
    "license": { "type": "string", "default": "MIT" },
    "homepage": { "type": "string", "format": "uri" }
  }
}
